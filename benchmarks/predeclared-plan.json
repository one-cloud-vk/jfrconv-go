    "rss": "wait4 high-water resident bytes, normalized by OS; Python harness excluded. Limited-process-tree diagnostic samples separately.",
    "latency": "whole CLI subprocess, startup and output writing included; p50 median and p95 nearest-rank",
    "verification": "remove expected output before each process; compare canonical output after every first-fresh, warmup, measured and instrumented RSS pair, outside subprocess intervals; pprof includes vector values/units/time and heatmap includes used IDs/RGB",
    "raw_trials": "retain every result, including command failure metrics, in an atomic report persisted after each process and verification; no outlier removal",
    "environment": "record immutable executable/JAR/input SHA256, toolchain/runtime versions, build info, flags, GOGC/GOMEMLIMIT/GOMAXPROCS/GODEBUG, hardware/OS",
    "quiet_slot": "no builds, native fixture profiling or other team CPU work during measurement",
    "input_isolation": "copy each input to the report directory before measurements; record SHA256 and recheck at case completion"
  },
