  "comparisons": "Each native implementation is paired with the same immutable Java baseline on identical inputs. Different native batches are not a direct Rust-vs-Go latency comparison.",
  "protocol": {
    "default_measured_pairs": 21,
    "equal_warmups_per_implementation": 1,
    "first_fresh_process_pair": "retained separately, excluded from percentiles; page-cache state uncontrolled",
